+# --- Turing (sm_75) shared-memory clamp ---------------------------------------
+# Attention tiles here are sized for Ampere, which has 164KB of shared memory per
+# SM. Turing has 64KB, so the default K+V tiles across num_stages overflow and the
+# kernel fails at launch with OutOfResources. Shrink block_n until it fits rather
+# than reducing num_stages, which would cost the pipelining.
+_smem_limit_cache = {}
+
+
+def _max_smem(device):
+    idx = device.index if getattr(device, "index", None) is not None else 0
+    lim = _smem_limit_cache.get(idx)
+    if lim is None:
+        props = torch.cuda.get_device_properties(idx)
+        lim = getattr(props, "shared_memory_per_block_optin", 0)
+        if not lim:
+            lim = 65536 if props.major < 8 else 101376
+        _smem_limit_cache[idx] = lim
+    return lim
+
+
+def _clamp_block_n_for_smem(device, block_n, head_dim, max_stages=3, margin=0.9):
+    # K and V tiles, fp16, held across max_stages pipeline stages.
+    budget = int(_max_smem(device) * margin)
+    while block_n > 16 and block_n * head_dim * 4 * max_stages > budget:
+        block_n //= 2
+    return block_n
+
+
+def _clamp_tiles_for_smem(device, block_m, block_n, head_dim, margin=0.9):
+    """Largest (block_m, block_n) whose Q/K/V tiles fit this device's shared memory.
+
+    Turing allows 64KB per block against Ampere's 164KB, so tiles tuned on newer
+    hardware overflow at launch. Shrink block_n first (it is doubly weighted, and
+    the K loop simply runs more iterations), then block_m.
+    """
+    budget = int(_max_smem(device) * margin)
+
+    def need(bm, bn):
+        return bm * head_dim * 2 + bn * head_dim * 8
+
+    while need(block_m, block_n) > budget:
+        if block_n > 16:
+            block_n //= 2
+        elif block_m > 16:
+            block_m //= 2
+        else:
+            break
+    return block_m, block_n
+
+
+def _clamp_stages_for_smem(device, block_n, head_dim, ns, margin=0.9):
+    """Largest pipeline depth whose K+V tiles fit this device's shared memory.
+
+    Turing allows 64KB per block against Ampere's 164KB, so depths tuned on newer
+    hardware overflow at launch. Returns at least 1: a depth-1 pipeline is slow but
+    always fits.
+    """
+    budget = int(_max_smem(device) * margin)
+    per_stage = max(1, block_n * head_dim * 4)
+    return max(1, min(int(ns), budget // per_stage))
+# ------------------------------------------------------------------------------
+
+
